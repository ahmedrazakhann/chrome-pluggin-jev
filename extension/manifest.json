{
  "manifest_version": 3,
  "name": "Twenty Browser Assistant",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Twenty's branded browser assistant for secure local automation.",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "sidePanel", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "externally_connectable": { "matches": ["http://localhost/*", "http://127.0.0.1/*"] },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "default_locale": "en"
}
